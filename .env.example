MODELSCOPE_API_KEY=
MODELSCOPE_ENDPOINT=https://modelscope.cn
# 线上公开访问地址，用于登录 Cookie 与同站请求校验，本机留空。
APP_ORIGIN=
# 可选：账号数据库与调用额度保存目录。
# Docker 默认 /mnt/workspace/jdtool，本机默认 .local/accounts。
# APP_DATA_DIR=
# 普通解析、改写和聊天走 ChatECNU；公司资料及复杂项目分析使用 ecnu-max。
MODEL_PROVIDER=chatecnu
# 百炼华北2（北京）的通用 API Key，仅用于联网搜索。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-27b
# 联网搜索使用独立模型额度，不跟随通用模型设置。
DASHSCOPE_SEARCH_MODEL=qwen3.8-flash
# 可选：仅公司分析在两个ECNU模型失败后使用百炼，消耗所选模型Token额度。
COMPANY_ANALYSIS_FALLBACK_PROVIDER=disabled
DASHSCOPE_COMPANY_MODEL=deepseek-v4-flash-0731
# 自动选择：博查 > Tavily > 百炼原生联网搜索。也可指定 bailian/bocha/tavily，disabled 关闭自动搜索。
# 百炼联网搜索工具单独计费，不包含在模型的免费 Token 额度中。
SEARCH_PROVIDER=bailian
# ChatECNU 配置。
CHAT_ECNU_API_KEY=
CHAT_ECNU_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
CHAT_ECNU_MODEL=ecnu-plus
CHAT_ECNU_COMPLEX_MODEL=ecnu-max
CHAT_ECNU_VISION_MODEL=ecnu-max
# 可选：使用独立搜索服务替代百炼联网搜索。
BOCHA_API_KEY=
TAVILY_API_KEY=
# 可选：本地语音识别模型目录。先运行 npm run prepare:asr 下载固定版本。
# Docker 已内置模型，无需语音服务 Key；本机默认 .local/asr-model。
# ASR_MODEL_DIR=
